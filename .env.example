# Public site origin for canonical URLs, sitemap, and Open Graph.
# Leave unset in local development. Set in Vercel once the preview or
# custom domain is known. Do not guess Issy's GoDaddy domain.
# NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Random secret for admin sessions. Required on Vercel.
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# The only admin login. Use a mailbox Matt or Issy actually control.
# ADMIN_EMAIL=

# bcrypt hash of the admin password. Never put the raw password here.
# Create one with: npm run hash-admin-password -- "your-password"
# ADMIN_PASSWORD_HASH=

# Vercel Blob read/write token. Required to save admin changes on Vercel.
# Create a Blob store in the Vercel project and copy the token.
# BLOB_READ_WRITE_TOKEN=

# Optional local override for the content JSON path. Defaults to .data/site-content.json
# CONTENT_DATA_PATH=
