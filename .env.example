# Public site origin for canonical URLs, sitemap, and Open Graph.
# Leave unset in local development. On Vercel use the current preview or
# production origin. Do not guess Issy's GoDaddy domain.
# A trailing slash is optional; the app strips it.
# NEXT_PUBLIC_SITE_URL=https://mrsgillenglish.vercel.app

# Random secret for admin sessions. Required on Vercel.
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Up to four /admin logins. Fill a matching email + password hash pair.
# Unused slots can stay empty. At least one complete pair is required.
# Create each hash with: npm run hash-admin-password -- "your-password"
# Never put the raw password in this file or in Git.
# ADMIN_EMAIL_1=
# ADMIN_PASSWORD_HASH_1=
# ADMIN_EMAIL_2=
# ADMIN_PASSWORD_HASH_2=
# ADMIN_EMAIL_3=
# ADMIN_PASSWORD_HASH_3=
# ADMIN_EMAIL_4=
# ADMIN_PASSWORD_HASH_4=
#
# Slot 1 also accepts the older unnumbered names:
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# Vercel Blob read/write token. Required to save admin changes on Vercel.
# Create a Blob store in the Vercel project and copy the token.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY may appear when Blob is created.
# This app does not read them.

# Optional local override for the content JSON path. Defaults to .data/site-content.json
# CONTENT_DATA_PATH=
